# URL Web App Apps Script hasil Deploy > Manage deployments.
# Wajib berakhiran /exec dan diatur "Who has access: Anyone".
GAS_WEB_APP_URL=https://script.google.com/macros/s/GANTI_DENGAN_ID_DEPLOYMENT_ANDA/exec
